# X-Robots-Tag on the text files: crawling stays allowed, and these stay out of search results (docs/specs/META.md section 2).
/llms.txt
  X-Robots-Tag: noindex
/data.json
  X-Robots-Tag: noindex
/catalog.csv
  X-Robots-Tag: noindex
/catalog-index.csv
  X-Robots-Tag: noindex
/names.json
  X-Robots-Tag: noindex
/schema/*
  X-Robots-Tag: noindex
# The read API's internal projections and its public bulk catalog (docs/specs/CONTRACTS.md
# sections 5 and 6). No Access-Control-Allow-Origin line here: Pages sends * on its static files,
# and a second value would break CORS; tools/check-site.mjs holds the header.
/apidata/*
  X-Robots-Tag: noindex
/api/v1/catalog/*
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
# The consent page of a connected app answers no frame: a click on it could be someone else's
# (docs/specs/CONTRACTS.md section 1; tools/check-site.mjs holds the two headers).
/connect
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
/connect/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
/en/connect
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
/en/connect/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
