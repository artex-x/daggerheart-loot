# OS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp
*~

# Junk
node_modules/
*.log

# Sources and drafts
Vol*.pdf
tools/__pycache__/
tools/vault_extract.py

# Drafts and one-off exports: needed while working, not on the site
export/
*-PLAN.md
*-DESIGN.md
# ...except those under docs/: those are the specs, and they are the source of truth
!docs/**

# Build output of the app.
dist/
coverage/
.svelte-kit/

# A dispatched agent's isolated worktree is host infrastructure, not source.
.claude/worktrees/

# Untracked artwork scratch (refresh-artwork sessions write here). Both this
# and the worktrees line above have to live in .gitignore, not only
# .prettierignore: tree-key.mjs's commit-gate fingerprint runs `git add -A`,
# which reads .gitignore only, so a .prettierignore-only entry stops Prettier
# tripping but still leaves the path inside every fingerprint.
work/

# The share stubs: 1091 files regenerated from data.js by tools/build.js,
# which the deploy job runs (npm run build) before it copies i/ into _site.
# Published, never committed, and never hand-edited (.claude/hooks/edit-guard.mjs).
# data.json and catalog.csv stay tracked on purpose - seven vitest suites and
# two tests/app suites read data.json off disk under `npm run test`, which
# does not build first. See issues/untrack-stubs/plan.md.
i/

# Per-suite logs from tests/run-all.js: the CI artifact, not source.
test-output/

# tools/tg-preview/'s local credentials (docs/tg-preview.md, step D.2): a
# TG_SESSION value is a full Telegram account and must never be tracked.
# *.env also catches local.env, a bare name with no leading dot.
.env
.env.*
*.env
# The atomic state write's temp file, left behind only if a run is killed
# between write and rename.
tools/tg-preview/state.json.tmp
