# OS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp
*~

# Junk
node_modules/
*.log

# Source books and the local extraction script: never published
Vol*.pdf
tools/__pycache__/
tools/vault_extract.py

# Build output of the app, and its test build (tests/app/ drive it).
dist/
dist-test/
coverage/

# A dispatched agent's isolated worktree is host infrastructure, not source.
.claude/worktrees/

# Untracked artwork scratch (refresh-artwork sessions write here). Both this
# and the worktrees line above have to live in .gitignore, not only
# .prettierignore: tree-key.mjs's commit-gate fingerprint runs `git add -A`,
# which reads .gitignore only, so a .prettierignore-only entry stops Prettier
# tripping but still leaves the path inside every fingerprint.
work/

# The impeccable skill's own hook rewrites these three during a session;
# only this host's .git/info/exclude ignores them today, which a fresh
# clone or CI does not carry, so they need the tracked entry the
# worktrees line above does. Named individually, not as .impeccable/
# itself: design.json also lives there and is tracked project data, not
# hook runtime state. config.local.json is the one that matters most - a
# local config file with no tracked ignore is how a credential gets
# committed by accident.
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/config.local.json

# The share stubs: one file per record and language (i/ and i/en/) regenerated from
# data.js by tools/build.js, which the deploy job runs (npm run build) before
# it copies i/ into _site. en/ is the English entry document, generated and
# published the same way.
# Published, never committed, and never hand-edited (.claude/hooks/edit-guard.mjs).
i/
/en/
# data.json and catalog.csv are data.js as JSON and as a table, generated
# and published the same way; vitest reads the catalog from data.js
# (app/src/test/loot.ts).
/data.json
/catalog.csv
# names.json is the preview host's name map, generated and published the same
# way (docs/specs/CONTRACTS.md section 4); nothing reads it off disk before a build.
/names.json
# catalog-index.csv is catalog.csv without its text, generated and published
# the same way.
/catalog-index.csv
# card-versions.json is each record's card version; the build appends it to the
# published data.js as window.LOOT_V (tools/data-script.js). Never published.
/card-versions.json

# The preview host's own install and wrangler's local state (preview/).
preview/node_modules/
preview/.wrangler/
# The deploy copies the site into preview/public/ beside the three Pages control
# files; _site/, _old/ and _cf/ are the deploy's and the local Pages run's copies.
preview/public/*
!preview/public/_worker.js
!preview/public/_routes.json
!preview/public/_headers
/_site/
/_old/
/_cf/

# The site pages: generated by tools/build.js from pages/src/ (authored and
# tracked). Published, never committed.
pages/*.html
pages/en/*.html

# Per-suite logs from tests/run-all.js: the CI artifact, not source.
test-output/

# Local credentials (.env.test.local, a tool's secrets) are never tracked.
# *.env also catches local.env, a bare name with no leading dot.
.env
.env.*
*.env
# Encrypted safety backups that npm run restore:prod takes before it writes
# production (.claude/README.md, "Restore production (owner)").
/.restore-safety/
