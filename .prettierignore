# Hook runtime state: gitignored (.claude/.gitignore), but Prettier does not
# read a nested .gitignore, so format:check would otherwise trip on whatever
# a live hook wrote during the session.
.claude/.check-cache.json
.claude/.check-db-cache.json
.claude/.check-index
.claude/.hook-state.json

# Same class: the impeccable skill's hook and CLI rewrite these four during
# a session, and Prettier does not read the .git/info/exclude entries that
# ignore some of them locally today, so format:check trips on them same as
# the entries above. config.json is the CLI's own store - `impeccable hooks
# ignore-value` writes it unformatted, which reddens format:check the moment
# a finding is suppressed. Listed individually, not as the whole
# .impeccable/ directory: design.json also lives there, is tracked,
# hand-authored project data, and has to stay checked.
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/config.local.json
.impeccable/config.json

# Machine-written: npm run db:push writes applied.json; the Supabase CLI owns
# the two gitignored scratch directories.
supabase/applied.json
supabase/.temp/
supabase/.branches/

# A dispatched agent's isolated worktree is host infrastructure, not source,
# and can land nested under this tree's own .claude/ directory unpredictably
# (a host placement choice, not this repository's). A repo-root
# `prettier --check .` walks into one if it is there, reddening format:check
# (hence npm run check) for a reason no diff in this tree explains - it
# blocked a commit gate once already.
# Also in .gitignore, which is the superset: Prettier's own default
# `--ignore-path` is [".gitignore", ".prettierignore"] together, but
# tree-key.mjs's commit-gate fingerprint runs `git add -A`, which reads only
# .gitignore, so this file alone would silence Prettier while leaving the
# path inside every fingerprint.
.claude/worktrees/

