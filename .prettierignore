# Generated data, not authored: node tools/build.js writes these, and
# reformatting a machine-written file produces an unreadable diff for no
# behaviour change. `app.js`, `style.css` and the root `index.html` (the
# pre-rewrite live app) were the same kind of entry until R0c deleted them
# (issue 47) - the bare `index.html` pattern below matched both that file and
# app/index.html, so deleting the root file's own entries left app/index.html
# newly unignored. It gets its own line instead: R0c makes no template or
# markup change under app/ (comment re-points only), so this is not the batch
# that decides its formatting.
data.js
data.json
catalog.csv
i/
img/
og/
card/
app/index.html
tests/
tools/
dist/
coverage/
node_modules/
docs/fixtures/

# Hook runtime state: gitignored (.claude/.gitignore), but Prettier does not
# read a nested .gitignore, so format:check would otherwise trip on whatever
# a live hook wrote during the session.
.claude/.check-cache.json
.claude/.check-index
.claude/.hook-state.json

# Markdown is wrapped by hand: in the READMEs and specs a line break carries
# meaning, and the licence notice has to stay on one line (tests/derived.js pins it).
*.md
