{
  "name": "daggerheart-loot",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run data && vite build",
    "build:test": "npm run data && vite build --mode test",
    "preview": "vite preview",
    "data": "node tools/build.js",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier/.prettier-cache",
    "lint": "eslint .",
    "lint:untyped": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ --ignore-pattern \"app/src/**\" --ignore-pattern app/vitest-setup.ts --ignore-pattern vite.config.mts",
    "lint:typed": "eslint app/src app/vitest-setup.ts vite.config.mts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:legacy": "node tests/run-all.js",
    "budget": "node tools/bundle-budget.mjs",
    "check:fast": "npm run lint && npm run typecheck && npm run test",
    "check": "node .claude/hooks/gate-credit.mjs begin check && node --test --test-reporter=dot tools/check/lib.test.mjs && node tools/check/run.mjs && node .claude/hooks/gate-credit.mjs arm check",
    "check:built": "npm run build && npm run build:test && npm run smoke && npm run budget && node tools/no-fake-in-prod.mjs",
    "check:db": "node tests/db/run.mjs",
    "smoke": "node tools/smoke-http.mjs",
    "previews": "node tools/tg-preview/run.mjs",
    "review:images": "node tools/artwork/run.mjs review --open",
    "config:diff": "node tools/supabase/config.mjs diff",
    "config:push": "node tools/supabase/config.mjs push",
    "db:push": "node tools/supabase/db-push.mjs",
    "limits:set": "node tools/supabase/limits.mjs",
    "restore:drill": "node tools/supabase/restore-drill.mjs",
    "restore:prod": "node tools/supabase/restore-prod.mjs",
    "e2e": "node --env-file-if-exists=.env.test.local --import ./tests/e2e/ts-hooks.mjs tests/e2e/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@orama/stemmers": "3.1.18",
    "@supabase/supabase-js": "2.117.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "age-encryption": "0.3.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "postgres": "3.4.9",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "puppeteer": "^25.9.0",
    "supabase": "2.117.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
